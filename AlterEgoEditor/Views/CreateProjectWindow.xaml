<Window x:Class="AlterEgoEditor.Views.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AlterEgoEditor.Converters"
        Title="New Project" Height="600" Width="850"
        WindowStyle="None"
        Background="#FF161616" Foreground="White"
        BorderBrush="#FF282828" BorderThickness="1"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="20" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Create New Project" FontSize="24" FontFamily="{StaticResource ZTNature}" Margin="0,0,0,5"/>
            <TextBlock Text="Please fill out this form for your new mod project. Fields marked with an asterisk (*) are required." FontSize="12" FontFamily="{StaticResource ZTNature}" FontWeight="Light" Margin="0,0,0,20"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Name*" Foreground="White" />
                <TextBox Grid.Column="2" x:Name="txtProjectName" Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Background="#FF282828" Foreground="White" BorderThickness="0" Padding="5"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Author*" Foreground="White"/>
                <TextBox Grid.Column="2" x:Name="txtAuthorName" Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}" Background="#FF282828" Foreground="White" BorderThickness="0" Padding="5"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Grid.Row="3" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Game*" Foreground="White"/>
                <ComboBox Grid.Column="2" Grid.Row="3" ItemsSource="{Binding AvailableGames}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="GameTitle" Background="#FF282828" Foreground="White" BorderThickness="0" Padding="5"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Category" Foreground="White"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding ModCategories}" SelectedItem="{Binding SelectedCategory}" Background="#FF282828" Foreground="White" BorderThickness="0" Padding="5"/>
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Margin="0,3,10,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Mod Media" Foreground="White"/>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding BrowseModIconCommand}" Width="110" Height="110" Background="#FF282828" BorderBrush="#FF444444" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="Add Mod Icon" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                            Visibility="{Binding ModIconPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <Image Source="{Binding ModIconPath}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="2">
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <UniformGrid Rows="1" Columns="5">
                                <Button Command="{Binding BrowseModIconCommand}" Width="110" Height="110" Background="#FF282828" BorderBrush="#FF444444" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" Margin="0,0,10,0">
                                    <Grid>
                                        <TextBlock Text="Add Screenshot" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                            Visibility="{Binding ModIconPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <Image Source="{Binding ModIconPath}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Command="{Binding BrowseModIconCommand}" Width="110" Height="110" Background="#FF282828" BorderBrush="#FF444444" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" Margin="0,0,10,0">
                                    <Grid>
                                        <TextBlock Text="Add Screenshot" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                            Visibility="{Binding ModIconPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <Image Source="{Binding ModIconPath}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Command="{Binding BrowseModIconCommand}" Width="110" Height="110" Background="#FF282828" BorderBrush="#FF444444" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" Margin="0,0,10,0">
                                    <Grid>
                                        <TextBlock Text="Add Screenshot" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                            Visibility="{Binding ModIconPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <Image Source="{Binding ModIconPath}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Command="{Binding BrowseModIconCommand}" Width="110" Height="110" Background="#FF282828" BorderBrush="#FF444444" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" Margin="0,0,10,0">
                                    <Grid>
                                        <TextBlock Text="Add Screenshot" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                            Visibility="{Binding ModIconPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <Image Source="{Binding ModIconPath}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Command="{Binding BrowseModIconCommand}" Width="110" Height="110" Background="#FF282828" BorderBrush="#FF444444" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" Margin="0,0,10,0">
                                    <Grid>
                                        <TextBlock Text="Add Screenshot" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                            Visibility="{Binding ModIconPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <Image Source="{Binding ModIconPath}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Margin="0,3,10,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Description" Foreground="White"/>
                <TextBox Grid.Column="2" x:Name="txtDescription" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Background="#FF282828" Foreground="White" BorderThickness="0" Padding="5"/>
            </Grid>

        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelAndCloseCommand}" Width="100" Height="30" Background="Transparent" Foreground="White" Margin="0,0,10,0"/>
            <Button Content="Create Mod" Command="{Binding CreateProjectAndCloseCommand}" Width="100" Height="30" Background="#FF282828" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>